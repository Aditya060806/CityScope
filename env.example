# ============================================================================
# ROAD ANOMALY DETECTION (PRAD) CONFIGURATION
# ============================================================================
VITE_ENABLE_ROAD_ANOMALY_DETECTION=true
# Keep true for production bridge mode: mobile app writes, website reads/listens only.
VITE_PRAD_WEB_READ_ONLY=true

# Map heatmap behavior
# true -> merge civic issues + PRAD anomalies in /map heat mode.
# false -> legacy civic-only heatmap path.
VITE_MAP_HEATMAP_MERGED_SOURCES=true

# true -> balance issue/anomaly contribution when merged heatmap source is All.
# false -> raw source counts drive hotspot intensity.
VITE_MAP_HEAT_BALANCED_MERGE=true

# Detection thresholds
VITE_PRAD_ACCELERATION_THRESHOLD=18
VITE_PRAD_SAMPLING_RATE_HZ=20
VITE_PRAD_MIN_SPEED_MS=1.4
VITE_PRAD_DEBOUNCE_MS=2000
VITE_PRAD_CLUSTER_RADIUS_M=25
VITE_PRAD_MIN_CLUSTER_COUNT=3

# ============================================================================

# Deployer Wallet Private Key (for deploying contract)
DEPLOYER_PRIVATE_KEY=your-deployer-private-key

# Base Network RPCs
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

